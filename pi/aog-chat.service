[Unit]
Description=AOG asistan vekili (hizli/orta/derin)
After=network.target

[Service]
Type=simple
User=demir
WorkingDirectory=/home/demir/aog-pi
Environment=LLAMA_BIN=/home/demir/aog-pi/llama.cpp/build/bin/llama-server
Environment=AOG_MD=/home/demir/aog-pi/AOG.md
Environment=HIZLI_GGUF=/home/demir/aog-pi/models/Qwen_Qwen3.5-0.8B-Q4_K_M.gguf
Environment=ORTA_GGUF=/home/demir/aog-pi/models/gemma-4-E2B-it-Q4_K_M.gguf
Environment=DERIN_GGUF=/home/demir/aog-pi/models/DeepSeek-R1-Distill-Qwen-1.5B-Q4_K_M.gguf
Environment=LISTEN=0.0.0.0
Environment=PORT=8080
ExecStart=/usr/bin/python3 /home/demir/aog-pi/chat_proxy.py
Restart=on-failure
RestartSec=4

[Install]
WantedBy=multi-user.target
